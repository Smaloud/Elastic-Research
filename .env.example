# 个人单机默认值；若端口冲突，可只修改左侧暴露端口。
PAPERLIB_PORT=8765
POSTGRES_PORT=54329
POSTGRES_DB=paperlib
POSTGRES_USER=paperlib
POSTGRES_PASSWORD=paperlib_dev

# 如 Google 镜像缓存不可达，可改为 python:3.12-slim。
PYTHON_IMAGE=mirror.gcr.io/library/python:3.12-slim

# 默认是约 220 MB 的中英多语种本地 embedding 模型，首次使用向量检索时下载。
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSION=384
